---
import { business, food } from '../lib/site-content';
import Media from './Media.astro';
import { ordered, localUrl, isSquareReady } from '../lib/content.mjs';
interface SectionData { id: string; enabled: boolean; order: number; type: string; label: string; heading: string; body: string; image: string; imageAlt: string; buttonLabel: string; buttonUrl: string; theme: string; }
interface Props { section: SectionData; first: boolean; foodAnchor?: string; }
const { section: s, first, foodAnchor } = Astro.props;
const Heading = first ? 'h1' : 'h2';
const ready = isSquareReady(business.squareUrl);
const href = s.buttonUrl === 'square' ? (ready ? business.squareUrl : '#ordering') : localUrl(s.buttonUrl, import.meta.env.BASE_URL);
const categories = ordered(food.categories);
---
<section id={s.id} class:list={['story-section', `section-${s.type}`, `theme-${s.theme}`]} aria-labelledby={`${s.id}-title`} data-section-type={s.type}>
  <p class="eyebrow"><span class="little-star" aria-hidden="true">✦</span>{s.label}</p>
  <Heading id={`${s.id}-title`}>{s.heading.split('\n').map((line, i) => <><span class:list={{ 'gold-line': s.type === 'hero' && i > 0 }}>{line}</span>{' '}</>)}</Heading>
  <div class="body-copy">{(s.body || '').split('\n\n').filter(Boolean).map(p => <p>{p}</p>)}</div>
  {s.image && <Media class="section-image" src={s.image} alt={s.imageAlt} width={800} loading={first ? 'eager' : 'lazy'} />}
  {s.type === 'categories' && <div class="food-grid">{categories.map((category, i) => <article class="food-category">
    {category.image ? <Media src={category.image} alt={category.imageAlt} width={400} /> : <span class="category-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>}
    <h3>{category.name}</h3><p>{category.description}</p>
    {category.squareUrl && <a class="text-link" href={category.squareUrl}>Explore {category.name.toLowerCase()} <span aria-hidden="true">↗</span></a>}
  </article>)}</div>}
  {s.type === 'featured' && <div class="featured-list">{categories.filter(c=>c.featured).map(c=><span>{c.name}</span>)}</div>}
  {s.type === 'story' && <p class="story-signature">With warmth, Moon Foods <span aria-hidden="true">✦</span></p>}
  {s.type === 'service' && <div class="service-list"><div><span aria-hidden="true">01</span><h3>Pick it up</h3><p>{business.pickupInfo}</p></div><div><span aria-hidden="true">02</span><h3>Make a night of it</h3><p>{business.deliveryInfo}</p></div></div>}
  {s.type === 'location' && <div class="location-card"><span class="location-icon" aria-hidden="true">⌖</span><div><h3>Where we’ll be</h3><p>{business.locationText}</p><h3>Opening hours</h3><p>{business.openingHours}</p></div></div>}
  {s.buttonLabel && href && <div class="section-actions"><a class="button" href={href} data-order={s.buttonUrl === 'square' ? 'true' : undefined}>{s.buttonLabel}<span aria-hidden="true">↗</span></a>{s.type === 'hero' && foodAnchor && <a class="secondary-link" href={`#${foodAnchor}`}>Meet the food <span aria-hidden="true">↓</span></a>}</div>}
  {s.type === 'hero' && <p class="hero-footnote">A little spice. A little comfort. A lot to love.</p>}
</section>
