    <g class="crisp"><path d="M225 491c84 50 172 62 280 0-4 27-70 62-134 61-64-1-133-33-146-61Z" fill="#df891e" stroke="#9d591b" stroke-width="5"/><path d="M237 505c78 38 167 48 256 0" stroke="#faca58" stroke-width="4"/>
